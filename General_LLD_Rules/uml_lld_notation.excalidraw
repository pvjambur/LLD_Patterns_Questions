  {
   "id": "el13_151998",
   "type": "text",
   "x": 26,
   "y": 736.5,
   "width": 570.96,
   "height": 315.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2096491879,
   "version": 1,
   "versionNonce": 474769609,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1795464137622,
   "link": null,
   "locked": false,
   "text": "+    public       anyone can access (API methods, getters)\n-    private       only inside the class (data fields)\n#    protected   class + its subclasses\n                       (base-class fields a child reads)\n~    package     same package / namespace (rare in C++)\nunderline         static member  (getInstance(), nextId)\nitalic / {abstract}   abstract class or pure virtual method\n\nAttribute syntax:   - name: Type\nMethod syntax:      + name(param: Type): ReturnType\n\nRule of thumb:\nfields are \"-\", behaviour is \"+\", shared with children is \"#\"\nDon't draw every getter, only methods that matter.",
   "originalText": "+    public       anyone can access (API methods, getters)\n-    private       only inside the class (data fields)\n#    protected   class + its subclasses\n                       (base-class fields a child reads)\n~    package     same package / namespace (rare in C++)\nunderline         static member  (getInstance(), nextId)\nitalic / {abstract}   abstract class or pure virtual method\n\nAttribute syntax:   - name: Type\nMethod syntax:      + name(param: Type): ReturnType\n\nRule of thumb:\nfields are \"-\", behaviour is \"+\", shared with children is \"#\"\nDon't draw every getter, only methods that matter.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
