   "locked": false
  },
  {
   "id": "el132_287193",
   "type": "text",
   "x": 26.0,
   "y": 3139.5,
   "width": 400.2,
   "height": 37.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
