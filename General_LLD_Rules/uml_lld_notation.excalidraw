  },
  {
   "id": "el126_602764",
   "type": "text",
   "x": 936.0,
   "y": 2437.0,
   "width": 400.2,
   "height": 37.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
