  },
  {
   "id": "el139_128887",
   "type": "text",
   "x": 1846.0,
   "y": 3195.5,
   "width": 489.59999999999997,
   "height": 340.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 324593663,
   "version": 1,
   "versionNonce": 1268759748,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1795464137622,
   "link": null,
   "locked": false,
   "text": "project/\n├── utils/        helpers: TimeUtils, IdGenerator\n├── enums/        Status, Type, Mode\n├── models/       entities (nouns): leaf models,\n│                 composite models, abstract bases\n│                 and their subclasses\n├── strategies/   interfaces + interchangeable\n│                 implementations\n├── factories/    factory interface + concrete\n│                 factories\n├── services/     stateless behaviour (notify, log)\n├── managers/     singletons that own collections\n├── <App>.h       facade / orchestrator\n└── main.cpp      client: runs one demo flow\n\nHeader-only build:\ng++ -std=c++17 -I. main.cpp -o app",
   "originalText": "project/\n├── utils/        helpers: TimeUtils, IdGenerator\n├── enums/        Status, Type, Mode\n├── models/       entities (nouns): leaf models,\n│                 composite models, abstract bases\n│                 and their subclasses\n├── strategies/   interfaces + interchangeable\n│                 implementations\n├── factories/    factory interface + concrete\n│                 factories\n├── services/     stateless behaviour (notify, log)\n├── managers/     singletons that own collections\n├── <App>.h       facade / orchestrator\n└── main.cpp      client: runs one demo flow\n\nHeader-only build:\ng++ -std=c++17 -I. main.cpp -o app",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
