  {
   "id": "el162_119613",
   "type": "text",
   "x": 26,
   "y": 3785.5,
   "width": 964.08,
   "height": 157.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1874335756,
   "version": 1,
   "versionNonce": 945161047,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1795464137622,
   "link": null,
   "locked": false,
   "text": "1.  main calls ONE method on the Facade  (app.placeOrder(...), app.parkVehicle(...), app.bookSeat(...))\n2.  Facade asks a Manager to find / validate existing objects  (lookup by id, search, availability)\n3.  Facade asks a Factory to create the right subclass for this request\n4.  The new Model object is registered with its Manager, so there is one source of truth\n5.  The part that varies is delegated to a Strategy  (payment, pricing, matching, routing)\n6.  Side effects go to a Service  (notify, log), then state is updated or cleaned up\nRule: every arrow is a call one layer DOWN. Nothing low in the stack ever calls upward.",
   "originalText": "1.  main calls ONE method on the Facade  (app.placeOrder(...), app.parkVehicle(...), app.bookSeat(...))\n2.  Facade asks a Manager to find / validate existing objects  (lookup by id, search, availability)\n3.  Facade asks a Factory to create the right subclass for this request\n4.  The new Model object is registered with its Manager, so there is one source of truth\n5.  The part that varies is delegated to a Strategy  (payment, pricing, matching, routing)\n6.  Side effects go to a Service  (notify, log), then state is updated or cleaned up\nRule: every arrow is a call one layer DOWN. Nothing low in the stack ever calls upward.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  }
