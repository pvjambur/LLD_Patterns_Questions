  {
   "id": "el102_412569",
   "type": "text",
   "x": 50,
   "y": 1606.3,
   "width": 1529.3200000000002,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2101315414,
   "version": 1,
   "versionNonce": 1380653906,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1795464289639,
   "link": null,
   "locked": false,
   "text": "Read any arrow as: the tail must be written before the head.  Columns L0..L6 = level (longest chain of prerequisites).  Everything in one column can be written in any order.",
   "originalText": "Read any arrow as: the tail must be written before the head.  Columns L0..L6 = level (longest chain of prerequisites).  Everything in one column can be written in any order.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
