  },
  {
   "id": "el104_373799",
   "type": "text",
   "x": 26,
   "y": 1760.3,
   "width": 504.59999999999997,
   "height": 37.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
