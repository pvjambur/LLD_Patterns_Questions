  {
   "id": "el108_767357",
   "type": "text",
   "x": 1016,
   "y": 1816.3,
   "width": 1188.0,
   "height": 300.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 478978338,
   "version": 1,
   "versionNonce": 1316897578,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1795464289639,
   "link": null,
   "locked": false,
   "text": "Class (role)      Folder      Stereotype In  Needs                                   Out  Level  e.g.\nUtils             utils       utility    0   - (basic unit)                          1    0      TimeUtils, IdGenerator\nEnum              enums       enum       0   - (basic unit)                          1    0      Status, Type, Mode\nInterface         strategies  interface  0   - (basic unit)                          2    0      PaymentStrategy, Shape, Notifier\nLeafModel         models      model      0   - (basic unit)                          1    0      Item, Seat, Book, Spot\nCompositeModel    models      model      1   LeafModel                               2    1      Cart, Show, Library, Floor\nConcreteStrategy  strategies  strategy   1   Interface                               1    1      UpiPayment, Circle, EmailNotifier\nAbstractBase      models      abstract   3   Interface, Enum, CompositeModel         4    2      Order, Account, Vehicle, Booking\nConcreteChild     models      concrete   1   AbstractBase                            1    3      SavingsAccount, Car, OnlineBooking\nService           services    service    1   AbstractBase                            1    3      NotificationService, PricingService\nFactoryInterface  factories   interface  1   AbstractBase                            1    3      VehicleFactory, OrderFactory\nManager           managers    singleton  1   AbstractBase                            1    3      Inventory, BookingManager, Registry\nConcreteFactory   factories   factory    3   ConcreteChild, FactoryInterface, Utils  1    4      CarFactory, InstantOrderFactory\nFacade            (root)      facade     4   CompositeModel, Service, Manager,       1    5      ParkingLotApp, LibraryApp, BankApp\n                                             ConcreteFactory\nmain              (root)      client     2   ConcreteStrategy, Facade                0    6      main.cpp",
   "originalText": "Class (role)      Folder      Stereotype In  Needs                                   Out  Level  e.g.\nUtils             utils       utility    0   - (basic unit)                          1    0      TimeUtils, IdGenerator\nEnum              enums       enum       0   - (basic unit)                          1    0      Status, Type, Mode\nInterface         strategies  interface  0   - (basic unit)                          2    0      PaymentStrategy, Shape, Notifier\nLeafModel         models      model      0   - (basic unit)                          1    0      Item, Seat, Book, Spot\nCompositeModel    models      model      1   LeafModel                               2    1      Cart, Show, Library, Floor\nConcreteStrategy  strategies  strategy   1   Interface                               1    1      UpiPayment, Circle, EmailNotifier\nAbstractBase      models      abstract   3   Interface, Enum, CompositeModel         4    2      Order, Account, Vehicle, Booking\nConcreteChild     models      concrete   1   AbstractBase                            1    3      SavingsAccount, Car, OnlineBooking\nService           services    service    1   AbstractBase                            1    3      NotificationService, PricingService\nFactoryInterface  factories   interface  1   AbstractBase                            1    3      VehicleFactory, OrderFactory\nManager           managers    singleton  1   AbstractBase                            1    3      Inventory, BookingManager, Registry\nConcreteFactory   factories   factory    3   ConcreteChild, FactoryInterface, Utils  1    4      CarFactory, InstantOrderFactory\nFacade            (root)      facade     4   CompositeModel, Service, Manager,       1    5      ParkingLotApp, LibraryApp, BankApp\n                                             ConcreteFactory\nmain              (root)      client     2   ConcreteStrategy, Facade                0    6      main.cpp",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
