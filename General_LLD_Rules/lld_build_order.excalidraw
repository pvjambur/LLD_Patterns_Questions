   "boundElements": null,
   "updated": 1795464289639,
   "link": null,
   "locked": false,
   "text": "Result: Utils  →  Enum  →  Interface  →  LeafModel  →  ConcreteStrategy  →  CompositeModel  →  AbstractBase  →  ConcreteChild  →  Service  →  FactoryInterface  →  Manager  →  ConcreteFactory  →  Facade  →  main",
   "originalText": "Result: Utils  →  Enum  →  Interface  →  LeafModel  →  ConcreteStrategy  →  CompositeModel  →  AbstractBase  →  ConcreteChild  →  Service  →  FactoryInterface  →  Manager  →  ConcreteFactory  →  Facade  →  main",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
