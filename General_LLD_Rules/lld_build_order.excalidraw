   "boundElements": null,
   "updated": 1795464289639,
   "link": null,
   "locked": false,
   "text": "4. Indegree, outdegree, level",
   "originalText": "4. Indegree, outdegree, level",
   "fontSize": 30,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "el105_275156",
   "type": "text",
   "x": 26,
   "y": 1816.3,
   "width": 627.12,
   "height": 292.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 763851704,
   "version": 1,
   "versionNonce": 1657724044,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1795464289639,
   "link": null,
   "locked": false,
   "text": "indegree(X)  = number of classes X needs before it can be written\n               (count the arrows coming INTO X in the build graph)\noutdegree(X) = number of classes that need X (its \"blast radius\")\n\nindegree 0   = a basic unit: includes nothing from the project,\n               so it can be written first\nhigh outdegree = many files depend on it, so design its interface\n               carefully up front and avoid changing it later\nlevel(X)     = 0 if indegree 0, else 1 + max(level of what X needs)\n               every class at one level can be written in any order\n\nTypical indegree-0 classes in ANY design:\nutils, enums, constants, pure interfaces, leaf models",
   "originalText": "indegree(X)  = number of classes X needs before it can be written\n               (count the arrows coming INTO X in the build graph)\noutdegree(X) = number of classes that need X (its \"blast radius\")\n\nindegree 0   = a basic unit: includes nothing from the project,\n               so it can be written first\nhigh outdegree = many files depend on it, so design its interface\n               carefully up front and avoid changing it later\nlevel(X)     = 0 if indegree 0, else 1 + max(level of what X needs)\n               every class at one level can be written in any order\n\nTypical indegree-0 classes in ANY design:\nutils, enums, constants, pure interfaces, leaf models",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
