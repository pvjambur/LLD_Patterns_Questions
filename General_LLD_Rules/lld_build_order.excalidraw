  {
   "id": "el3_198702",
   "type": "text",
   "x": 26,
   "y": 158,
   "width": 800.4,
   "height": 37.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
