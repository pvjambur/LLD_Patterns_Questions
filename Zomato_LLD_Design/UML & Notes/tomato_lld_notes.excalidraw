  {
   "id": "el13_151998",
   "type": "text",
   "x": 26,
   "y": 669.0,
   "width": 580.32,
   "height": 315.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
