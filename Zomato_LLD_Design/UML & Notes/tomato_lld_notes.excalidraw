   "seed": 2096491879,
   "version": 1,
   "versionNonce": 474769609,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1795424234948,
   "link": null,
   "locked": false,
   "text": "+    public       anyone can access (API methods, getters)\n-    private       only inside the class (data fields)\n#    protected   class + its subclasses\n                       (Order fields that DeliveryOrder reads)\n~    package     same package / namespace (rare in C++)\nunderline         static member  (getInstance(), nextId)\nitalic / {abstract}   abstract class or pure virtual method\n\nAttribute syntax:   - name: Type\nMethod syntax:      + name(param: Type): ReturnType\n\nRule of thumb:\nfields are \"-\", behaviour is \"+\", shared with children is \"#\"\nDon't draw every getter, only methods that matter.",
   "originalText": "+    public       anyone can access (API methods, getters)\n-    private       only inside the class (data fields)\n#    protected   class + its subclasses\n                       (Order fields that DeliveryOrder reads)\n~    package     same package / namespace (rare in C++)\nunderline         static member  (getInstance(), nextId)\nitalic / {abstract}   abstract class or pure virtual method\n\nAttribute syntax:   - name: Type\nMethod syntax:      + name(param: Type): ReturnType\n\nRule of thumb:\nfields are \"-\", behaviour is \"+\", shared with children is \"#\"\nDon't draw every getter, only methods that matter.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
