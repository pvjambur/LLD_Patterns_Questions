  {
   "id": "el139_128887",
   "type": "text",
   "x": 1846.0,
   "y": 3060.5,
   "width": 518.4,
   "height": 300.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 324593663,
   "version": 1,
   "versionNonce": 1268759748,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1795424234948,
   "link": null,
   "locked": false,
   "text": "tomato/\n├── models/       User, Cart, Restaurant, MenuItem,\n│                 Order, DeliveryOrder, PickupOrder\n├── strategies/   PaymentStrategy, UpiPayment,\n│                 CreditCardPayment, NetBankingPayment\n├── factories/    OrderFactory, NowOrderFactory,\n│                 ScheduledOrderFactory\n├── managers/     RestaurantManager, OrderManager\n├── services/     NotificationService\n├── utils/        TimeUtils, IdGenerator\n├── TomatoApp.h   facade / orchestrator\n└── main.cpp      client: runs one demo flow\n\nHeader-only build:\ng++ -std=c++17 -I. main.cpp -o tomato",
   "originalText": "tomato/\n├── models/       User, Cart, Restaurant, MenuItem,\n│                 Order, DeliveryOrder, PickupOrder\n├── strategies/   PaymentStrategy, UpiPayment,\n│                 CreditCardPayment, NetBankingPayment\n├── factories/    OrderFactory, NowOrderFactory,\n│                 ScheduledOrderFactory\n├── managers/     RestaurantManager, OrderManager\n├── services/     NotificationService\n├── utils/        TimeUtils, IdGenerator\n├── TomatoApp.h   facade / orchestrator\n└── main.cpp      client: runs one demo flow\n\nHeader-only build:\ng++ -std=c++17 -I. main.cpp -o tomato",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
