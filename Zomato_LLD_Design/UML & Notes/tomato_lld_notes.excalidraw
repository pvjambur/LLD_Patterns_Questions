  },
  {
   "id": "el10_334083",
   "type": "text",
   "x": 1846.0,
   "y": 214,
   "width": 608.4,
   "height": 315.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1354258845,
   "version": 1,
   "versionNonce": 1347402587,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1795424234948,
   "link": null,
   "locked": false,
   "text": "Singleton  →  RestaurantManager, OrderManager\n     one shared registry of restaurants and orders\n\nStrategy  →  PaymentStrategy (UPI, Credit, NetBanking)\n     swap payment behaviour at runtime\n\nFactory  →  OrderFactory (NowOrderFactory, ScheduledOrderFactory)\n     hides which Order subclass gets created\n\nFacade  →  TomatoApp\n     one simple entry point for the client (main.cpp)\n\nObserver (extension)  →  NotificationService\n     notify many channels (SMS, email, push) on events",
   "originalText": "Singleton  →  RestaurantManager, OrderManager\n     one shared registry of restaurants and orders\n\nStrategy  →  PaymentStrategy (UPI, Credit, NetBanking)\n     swap payment behaviour at runtime\n\nFactory  →  OrderFactory (NowOrderFactory, ScheduledOrderFactory)\n     hides which Order subclass gets created\n\nFacade  →  TomatoApp\n     one simple entry point for the client (main.cpp)\n\nObserver (extension)  →  NotificationService\n     notify many channels (SMS, email, push) on events",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
