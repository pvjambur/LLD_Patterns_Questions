   "locked": false
  },
  {
   "id": "el136_520884",
   "type": "text",
   "x": 1979.3333333333333,
   "y": 2482.25,
   "width": 539.4,
   "height": 37.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
