   "link": null,
   "locked": false,
   "text": "12. Exact file order (Kahn result) + what to test",
   "originalText": "12. Exact file order (Kahn result) + what to test",
   "fontSize": 30,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "el196_198697",
   "type": "text",
   "x": 26,
   "y": 4692.75,
   "width": 902.4,
   "height": 400.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 855250116,
   "version": 1,
   "versionNonce": 1900378883,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1795463233560,
   "link": null,
   "locked": false,
   "text": " 1. models/MenuItem.h                      in=0  create one, print name + price\n 2. strategies/PaymentStrategy.h           in=0  interface only: just make sure it compiles\n 3. utils/TimeUtils.h                      in=0  print now() and a time 2 hours later\n 4. models/Restaurant.h                    in=1  add 2 items, print the menu\n 5. strategies/UpiPayment.h                in=1  pay(320) prints a success line\n 6. strategies/CreditCardPayment.h         in=1  pay(320) prints a success line\n 7. strategies/NetBankingPayment.h         in=1  pay(320) prints a success line\n 8. models/Cart.h                          in=2  set restaurant, add by item code, print total\n 9. managers/RestaurantManager.h           in=1  add 2 restaurants, searchByLocation()\n10. models/User.h                          in=1  user.getCart() is usable\n11. models/Order.h                         in=4  abstract: compiles, cannot be instantiated\n12. models/DeliveryOrder.h                 in=1  create one, print getType() and total\n13. models/PickupOrder.h                   in=1  create one, print getType()\n14. services/NotificationService.h         in=1  notify(order) prints a summary\n15. managers/OrderManager.h                in=1  addOrder + getOrder(id)\n16. factories/OrderFactory.h               in=1  interface only: just make sure it compiles\n17. factories/NowOrderFactory.h            in=3  returns DeliveryOrder or PickupOrder by type\n18. factories/ScheduledOrderFactory.h      in=4  same, with a scheduled time set\n19. TomatoApp.h                            in=6  search, select, addToCart, checkout, pay\n20. main.cpp                               in=2  one full end-to-end flow",
   "originalText": " 1. models/MenuItem.h                      in=0  create one, print name + price\n 2. strategies/PaymentStrategy.h           in=0  interface only: just make sure it compiles\n 3. utils/TimeUtils.h                      in=0  print now() and a time 2 hours later\n 4. models/Restaurant.h                    in=1  add 2 items, print the menu\n 5. strategies/UpiPayment.h                in=1  pay(320) prints a success line\n 6. strategies/CreditCardPayment.h         in=1  pay(320) prints a success line\n 7. strategies/NetBankingPayment.h         in=1  pay(320) prints a success line\n 8. models/Cart.h                          in=2  set restaurant, add by item code, print total\n 9. managers/RestaurantManager.h           in=1  add 2 restaurants, searchByLocation()\n10. models/User.h                          in=1  user.getCart() is usable\n11. models/Order.h                         in=4  abstract: compiles, cannot be instantiated\n12. models/DeliveryOrder.h                 in=1  create one, print getType() and total\n13. models/PickupOrder.h                   in=1  create one, print getType()\n14. services/NotificationService.h         in=1  notify(order) prints a summary\n15. managers/OrderManager.h                in=1  addOrder + getOrder(id)\n16. factories/OrderFactory.h               in=1  interface only: just make sure it compiles\n17. factories/NowOrderFactory.h            in=3  returns DeliveryOrder or PickupOrder by type\n18. factories/ScheduledOrderFactory.h      in=4  same, with a scheduled time set\n19. TomatoApp.h                            in=6  search, select, addToCart, checkout, pay\n20. main.cpp                               in=2  one full end-to-end flow",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
