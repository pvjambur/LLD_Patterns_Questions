  },
  {
   "id": "el203_483729",
   "type": "text",
   "x": 2126.0,
   "y": 4692.75,
   "width": 570.96,
   "height": 202.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 41839275,
   "version": 1,
   "versionNonce": 725805843,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1795463233560,
   "link": null,
   "locked": false,
   "text": "• Never start a file whose prerequisites are unfinished\n• Interfaces usually have indegree 0: write them early\n• Same level = independent: order between them is free\n• Changing a high-outdegree class? rebuild all its dependents\n• Every new arrow in the UML = a new edge: update the graph\n• Keep models dumb; logic goes up into services/managers,\n  which keeps low layers small and stable\n• If a class has a huge indegree (TomatoApp: 6) it is a\n  coordinator; it should only delegate, never do the work",
   "originalText": "• Never start a file whose prerequisites are unfinished\n• Interfaces usually have indegree 0: write them early\n• Same level = independent: order between them is free\n• Changing a high-outdegree class? rebuild all its dependents\n• Every new arrow in the UML = a new edge: update the graph\n• Keep models dumb; logic goes up into services/managers,\n  which keeps low layers small and stable\n• If a class has a huge indegree (TomatoApp: 6) it is a\n  coordinator; it should only delegate, never do the work",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  }
