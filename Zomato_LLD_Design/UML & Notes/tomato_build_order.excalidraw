  {
   "id": "el128_188896",
   "type": "text",
   "x": 1056,
   "y": 1929.5,
   "width": 945.0,
   "height": 468.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1792394663,
   "version": 1,
   "versionNonce": 1418596893,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1795463233560,
   "link": null,
   "locked": false,
   "text": "Class                  Folder      Stereotype  In  Needs (prerequisites)                       Out  Level\nMenuItem               models      model       0   - (basic unit)                              3    0\nPaymentStrategy        strategies  interface   0   - (basic unit)                              4    0\nTimeUtils              utils       utility     0   - (basic unit)                              1    0\nRestaurant             models      model       1   MenuItem                                    3    1\nUpiPayment             strategies  strategy    1   PaymentStrategy                             1    1\nCreditCardPayment      strategies  strategy    1   PaymentStrategy                             0    1\nNetBankingPayment      strategies  strategy    1   PaymentStrategy                             0    1\nCart                   models      model       2   MenuItem, Restaurant                        1    2\nRestaurantManager      managers    singleton   1   Restaurant                                  1    2\nUser                   models      model       1   Cart                                        2    3\nOrder                  models      abstract    4   MenuItem, PaymentStrategy, Restaurant,      5    4\n                                                   User\nDeliveryOrder          models      concrete    1   Order                                       2    5\nPickupOrder            models      concrete    1   Order                                       2    5\nNotificationService    services    service     1   Order                                       1    5\nOrderManager           managers    singleton   1   Order                                       1    5\nOrderFactory           factories   interface   1   Order                                       2    5\nNowOrderFactory        factories   factory     3   DeliveryOrder, PickupOrder, OrderFactory    1    6\nScheduledOrderFactory  factories   factory     4   TimeUtils, DeliveryOrder, PickupOrder,      1    6\n                                                   OrderFactory\nTomatoApp              (root)      facade      6   RestaurantManager, User,                    1    7\n                                                   NotificationService, OrderManager,\n                                                   NowOrderFactory, ScheduledOrderFactory\nmain                   (root)      client      2   UpiPayment, TomatoApp                       0    8",
   "originalText": "Class                  Folder      Stereotype  In  Needs (prerequisites)                       Out  Level\nMenuItem               models      model       0   - (basic unit)                              3    0\nPaymentStrategy        strategies  interface   0   - (basic unit)                              4    0\nTimeUtils              utils       utility     0   - (basic unit)                              1    0\nRestaurant             models      model       1   MenuItem                                    3    1\nUpiPayment             strategies  strategy    1   PaymentStrategy                             1    1\nCreditCardPayment      strategies  strategy    1   PaymentStrategy                             0    1\nNetBankingPayment      strategies  strategy    1   PaymentStrategy                             0    1\nCart                   models      model       2   MenuItem, Restaurant                        1    2\nRestaurantManager      managers    singleton   1   Restaurant                                  1    2\nUser                   models      model       1   Cart                                        2    3\nOrder                  models      abstract    4   MenuItem, PaymentStrategy, Restaurant,      5    4\n                                                   User\nDeliveryOrder          models      concrete    1   Order                                       2    5\nPickupOrder            models      concrete    1   Order                                       2    5\nNotificationService    services    service     1   Order                                       1    5\nOrderManager           managers    singleton   1   Order                                       1    5\nOrderFactory           factories   interface   1   Order                                       2    5\nNowOrderFactory        factories   factory     3   DeliveryOrder, PickupOrder, OrderFactory    1    6\nScheduledOrderFactory  factories   factory     4   TimeUtils, DeliveryOrder, PickupOrder,      1    6\n                                                   OrderFactory\nTomatoApp              (root)      facade      6   RestaurantManager, User,                    1    7\n                                                   NotificationService, OrderManager,\n                                                   NowOrderFactory, ScheduledOrderFactory\nmain                   (root)      client      2   UpiPayment, TomatoApp                       0    8",
   "fontSize": 15,
   "fontFamily": 3,
