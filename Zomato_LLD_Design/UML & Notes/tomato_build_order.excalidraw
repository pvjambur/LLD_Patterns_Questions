   "roundness": null,
   "seed": 487147711,
   "version": 1,
   "versionNonce": 1009489084,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1795463233560,
   "link": null,
   "locked": false,
   "text": "Read any arrow as: the tail must be written before the head.  Columns L0..L8 = level (longest chain of prerequisites).  Everything in one column can be written in any order.",
   "originalText": "Read any arrow as: the tail must be written before the head.  Columns L0..L8 = level (longest chain of prerequisites).  Everything in one column can be written in any order.",
