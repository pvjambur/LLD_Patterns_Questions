   "link": null,
   "locked": false,
   "text": "Result: MenuItem  →  PaymentStrategy  →  TimeUtils  →  Restaurant  →  UpiPayment  →  CreditCardPayment  →  NetBankingPayment  →  Cart  →  RestaurantManager  →  User  →  Order  →  DeliveryOrder  →  PickupOrder  →  NotificationService  →  OrderManager  →  OrderFactory  →  NowOrderFactory  →  ScheduledOrderFactory  →  TomatoApp  →  main",
   "originalText": "Result: MenuItem  →  PaymentStrategy  →  TimeUtils  →  Restaurant  →  UpiPayment  →  CreditCardPayment  →  NetBankingPayment  →  Cart  →  RestaurantManager  →  User  →  Order  →  DeliveryOrder  →  PickupOrder  →  NotificationService  →  OrderManager  →  OrderFactory  →  NowOrderFactory  →  ScheduledOrderFactory  →  TomatoApp  →  main",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
