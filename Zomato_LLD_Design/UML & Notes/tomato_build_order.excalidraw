   "text": "13. Per-file checklist",
   "originalText": "13. Per-file checklist",
   "fontSize": 30,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "el200_640651",
   "type": "text",
   "x": 1296,
   "y": 4692.75,
   "width": 533.52,
   "height": 247.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 867174836,
   "version": 1,
   "versionNonce": 728246375,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1795463233560,
   "link": null,
   "locked": false,
   "text": "Inside every header, write in this order:\n1. #pragma once\n2. #include only the HARD prerequisites (already written)\n3. class X;  for the SOFT ones\n4. // «stereotype» comment\n5. private fields (UML attributes, the \"-\" ones)\n6. constructor\n7. getters\n8. behaviour methods (the \"+\" ones)\n9. virtual ~X() = default;  if it has virtual methods\n10. compile + test from main.cpp before the next file",
   "originalText": "Inside every header, write in this order:\n1. #pragma once\n2. #include only the HARD prerequisites (already written)\n3. class X;  for the SOFT ones\n4. // «stereotype» comment\n5. private fields (UML attributes, the \"-\" ones)\n6. constructor\n7. getters\n8. behaviour methods (the \"+\" ones)\n9. virtual ~X() = default;  if it has virtual methods\n10. compile + test from main.cpp before the next file",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
