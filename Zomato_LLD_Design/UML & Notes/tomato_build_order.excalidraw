  {
   "id": "el122_207119",
   "type": "text",
   "x": 50,
   "y": 1719.5,
   "width": 1529.3200000000002,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
