   "isDeleted": false,
   "boundElements": null,
   "updated": 1795463233560,
   "link": null,
   "locked": false,
   "text": "Strong vs weak association in your diagram:  strict composition (◆) = strong has-a,  aggregation (◇) = weak has-a,  simple association (──>) = knows-a",
   "originalText": "Strong vs weak association in your diagram:  strict composition (◆) = strong has-a,  aggregation (◇) = weak has-a,  simple association (──>) = knows-a",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
